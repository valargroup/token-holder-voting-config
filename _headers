/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/prod/dynamic-voting-config.json
  Cache-Control: public, max-age=60, must-revalidate, stale-if-error=86400

/stage/dynamic-voting-config.json
  Cache-Control: public, max-age=60, must-revalidate, stale-if-error=86400

/prod/pir.json
  Cache-Control: public, max-age=60, must-revalidate, stale-if-error=86400

/stage/pir.json
  Cache-Control: public, max-age=60, must-revalidate, stale-if-error=86400

/deployment-manifest.json
  Cache-Control: public, max-age=60, must-revalidate, stale-if-error=86400

/prod/static-voting-config.json
  Cache-Control: public, max-age=300, must-revalidate, stale-if-error=86400

/stage/static-voting-config.json
  Cache-Control: public, max-age=300, must-revalidate, stale-if-error=86400

/test/*
  Cache-Control: public, max-age=300, must-revalidate, stale-if-error=86400

/pins/*
  Cache-Control: public, max-age=31536000, immutable
